{
  "name": "nexus-local-ide",
  "productName": "Nexus",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@monaco-editor/react": "4.7.0",
    "lucide-react": "1.48.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "local.nexus.editor",
    "productName": "Nexus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "example-project/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "asar": true
  }
}
